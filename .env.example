# Copy to .env (git-ignored) and fill in. Never commit the real key.

GROQ_API_KEY=your_groq_api_key_here

# true  -> Groq rewrites the explanation text of the matcher's top-3 cards
# false -> deterministic template explanations only (no network calls)
ENABLE_LLM_EXPLANATIONS=true

# true  -> Groq extracts services / language / event type from the free-text query
#          (validated against the dataset; explicit form fields always win)
# unset -> same as ENABLE_LLM_EXPLANATIONS
ENABLE_LLM_INTENT=true

# Optional
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_TIMEOUT_S=8   # per call; lower it (e.g. 4) for snappier demos, fallback covers timeouts
